{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hk-ai",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-11-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "HK_RATE_LIMITER",
        "class_name": "RateLimiter",
        "script_name": "hk-ai-rate-limiter"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "env": {
    "preview": {
      "durable_objects": {
        "bindings": [
          {
            "name": "HK_RATE_LIMITER",
            "class_name": "RateLimiter",
            "script_name": "hk-ai-rate-limiter"
          }
        ]
      },
      "ai": {
        "binding": "AI"
      }
    }
  }
}
